NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://portfolio:change-me@127.0.0.1:5432/portfolio_cms?schema=public

# 32 random bytes, base64:  openssl rand -base64 32
# Encrypts 2FA secrets at rest. Required.
APP_ENCRYPTION_KEY=

# Comma-separated origins allowed to read the public API cross-origin (local Docker dev only).
PUBLIC_ORIGINS=http://localhost:5173
# Extra origins allowed to call the admin API with credentials. Leave empty: on Vercel the
# admin dashboard shares the site's origin, and same-origin is always allowed.
ADMIN_ORIGINS=

# Uploads. Unset locally = files go to ./uploads. Required in production (Vercel Blob store token).
# BLOB_READ_WRITE_TOKEN=

# --- Vercel / production --------------------------------------------------------------
# DATABASE_URL           pooled connection string (e.g. Neon "pooled")
# DATABASE_URL_UNPOOLED  direct connection string, used for migrations
# NODE_ENV               set to production automatically by Vercel
# TRUST_PROXY=1          Vercel is detected automatically; set only for other hosts
# SESSION_IDLE_MINUTES=120
# SESSION_ABSOLUTE_HOURS=12
# VISIT_RETENTION_DAYS=90   visitor analytics (IP addresses) are deleted after this many days
